{
  "name": "@sorlo/cms",
  "version": "0.1.0",
  "description": "An open-source, schema-driven CMS: its server, admin and CLI",
  "keywords": [
    "cms",
    "headless-cms",
    "content-management",
    "schema",
    "postgres",
    "hono",
    "mcp",
    "sorlo"
  ],
  "homepage": "https://github.com/WeAreSorlo/cms#readme",
  "bugs": "https://github.com/WeAreSorlo/cms/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeAreSorlo/cms.git",
    "directory": "packages/cms"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sorlo": "./bin/sorlo.js"
  },
  "files": [
    "bin",
    "dist",
    "admin/dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && vite build --config admin/vite.config.ts",
    "prepack": "npm run build",
    "pretest": "tsup && npm run build --prefix ../sdk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@sorlo/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "file-type": "^22.2.0",
    "flydrive": "^2.2.0",
    "hono": "^4.13.14",
    "@sorlo/forms": "file:../../../core",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "i18next": "^24.2.2",
    "lucide-react": "1.63.0",
    "react-i18next": "^15.4.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sass": "^1.106.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
