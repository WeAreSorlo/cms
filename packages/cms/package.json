{
  "name": "@sorlo/cms",
  "version": "0.2.0",
  "description": "An open-source, schema-driven CMS: its server, admin and CLI",
  "keywords": [
    "cms",
    "headless-cms",
    "content-management",
    "schema",
    "postgres",
    "hono",
    "mcp",
    "sorlo"
  ],
  "homepage": "https://github.com/WeAreSorlo/cms#readme",
  "bugs": "https://github.com/WeAreSorlo/cms/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeAreSorlo/cms.git",
    "directory": "packages/cms"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": "./admin/dist/index.js"
  },
  "bin": {
    "sorlo": "./bin/sorlo.js"
  },
  "files": [
    "bin",
    "dist",
    "admin/dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && vite build --config admin/vite.config.ts && npm run build:docs",
    "build:docs": "node -e \"fs.rmSync('docs', { recursive: true, force: true }); fs.cpSync('../../docs', 'docs', { recursive: true })\"",
    "prepack": "npm run build",
    "pretest": "tsup && npm run build --prefix ../sdk && npm run build --prefix ../field-markdown && vite build --config admin/vite.config.ts --logLevel warn",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sorlo/field-markdown": "^0.1.0",
    "@sorlo/forms": "^0.1.0",
    "@sorlo/sdk": "^0.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "file-type": "^22.3.0",
    "flydrive": "^2.2.0",
    "hono": "^4.13.16",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "1.68.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sass": "^1.107.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
