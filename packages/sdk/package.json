{
  "name": "@sorlo/sdk",
  "version": "0.1.0",
  "description": "A typed client for the Sorlo CMS's delivery API, and sorlo types pull",
  "keywords": [
    "cms",
    "headless-cms",
    "sdk",
    "api-client",
    "typescript",
    "sorlo"
  ],
  "homepage": "https://github.com/WeAreSorlo/cms/blob/main/docs/sdk.md",
  "bugs": "https://github.com/WeAreSorlo/cms/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeAreSorlo/cms.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "sorlo": "./bin/sorlo.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
