{
  "name": "@iight/sdk",
  "version": "0.1.0",
  "description": "A typed client for the iight CMS's delivery API, and iight types pull",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "iight": "./bin/iight.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
