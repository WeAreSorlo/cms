{
  "name": "iight-cms-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "db": "docker compose up -d --wait",
    "dev": "npm run dev --workspace playground",
    "test": "npm test --workspace @iight/cms",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier packages playground --check",
    "format:fix": "prettier packages playground --write"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "^3.9.10"
  }
}
